#!/usr/bin/env python3
import os
import csv
import sys
import argparse
from rapidfuzz import process, fuzz

def create_index(music_dir):
    print(f"--> Indexing local music in {music_dir}...")
    index = []
    valid_exts = ('.flac', '.mp3', '.m4a', '.wav', '.ogg')
    
    for root, _, files in os.walk(music_dir):
        for file in files:
            if file.lower().endswith(valid_exts):
                clean_name = os.path.splitext(file)[0]
                index.append({
                    "path": os.path.join(root, file), 
                    "name": clean_name
                })
    print(f"--> Indexed {len(index)} local files.")
    return index

def main():
    parser = argparse.ArgumentParser(description="Match Spotify CSV to local files and export missing tracks to a new CSV.")
    parser.add_argument("csv_file", help="Path to the Spotify CSV file")
    parser.add_argument("music_dir", help="Path to your local music directory")
    parser.add_argument("-o", "--output", help="Output M3U filename", default=None)
    parser.add_argument("-t", "--threshold", type=float, default=70.0, help="Matching threshold (0-100)")
    
    args = parser.parse_args()

    base_name = os.path.splitext(os.path.basename(args.csv_file))[0]
    if not args.output:
        args.output = base_name + ".m3u"
    
    missing_csv_path = base_name + "_missing.csv"

    local_index = create_index(args.music_dir)
    local_names = [item['name'] for item in local_index]
    
    matches_found = 0
    total_tracks = 0
    missing_rows = []
    headers = []

    try:
        with open(args.csv_file, mode='r', encoding='utf-8') as f:
            reader = csv.DictReader(f)
            headers = reader.fieldnames
            
            with open(args.output, 'w', encoding='utf-8') as m3u:
                m3u.write("#EXTM3U\n")
                
                for row in reader:
                    total_tracks += 1
                    track = row.get('Track Name', '')
                    artist_raw = row.get('Artist Name(s)', '')
                    
                    if not track or not artist_raw:
                        missing_rows.append(row)
                        continue

                    primary_artist = artist_raw.split(';')[0].split(',')[0].strip()
                    search_query = f"{primary_artist} {track}"
                    
                    results = process.extract(search_query, local_names, scorer=fuzz.token_set_ratio, limit=5)
                    
                    match_found = False
                    for match_name, score, idx in results:
                        full_path = local_index[idx]['path']
                        
                        if primary_artist.lower() in full_path.lower():
                            if score >= args.threshold:
                                m3u.write(f"{full_path}\n")
                                matches_found += 1
                                print(f" [OK]  {score:.0f}% Match: {primary_artist} - {track} -> {os.path.basename(full_path)}")
                                match_found = True
                                break 
                    
                    if not match_found:
                        print(f" [??]  No valid match for: {primary_artist} - {track}")
                        missing_rows.append(row)

        if missing_rows:
            with open(missing_csv_path, 'w', encoding='utf-8', newline='') as csvfile:
                writer = csv.DictWriter(csvfile, fieldnames=headers)
                writer.writeheader()
                writer.writerows(missing_rows)
            print(f"--> Exported {len(missing_rows)} tracks to {missing_csv_path}")

        print(f"\nDone! Created {args.output}")
        print(f"Matched {matches_found}/{total_tracks} tracks ({matches_found/total_tracks*100:.1f}%).")
        
    except FileNotFoundError:
        print(f"Error: Could not find file {args.csv_file}")
    except KeyError as e:
        print(f"Error: Missing expected column in CSV: {e}")

if __name__ == "__main__":
    main()
